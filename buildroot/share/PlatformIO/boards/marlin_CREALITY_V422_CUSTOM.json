{
  "name": "Creality V4.2.2 Custom",
  "vendor": "Creality",
  "url": "https://www.creality.com/",
  "frameworks": ["arduino"],
  "platform": "ststm32",

  "build": {
    "core": "stm32",
    "mcu": "stm32f103rc",
    "variant": "MARLIN_F103RC_CREALITY",
    "f_cpu": "72000000L",
    "extra_flags": "-DSTM32F1xx -DSTM32F103RC"
  },

  "upload": {
    "protocol": "stlink",
    "maximum_size": 524288,
    "maximum_ram_size": 65536
  },

  "debug": {
    "default_tools": ["stlink"]
  }
}
